<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ur5 urdf file -->
    <xacro:include filename="$(find ur5_robot_gripper)/urdf/ur_robotiq_isaac.urdf" />

    Import control_xacro
    <xacro:include filename="ur5.ros2_control.xacro" />


    <xacro:ur5_ros2_control name="use_isaac" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
